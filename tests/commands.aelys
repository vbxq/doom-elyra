use std::sys
use std::io::{println}
use engine
use screen
extern "SDL2" { fn SDL_PushEvent(event: &mut [u8]) -> i32 }
fn check(ok: bool, label: string) {
    if !ok { println("FAIL {label}"); sys::exit(1) }
}
fn key(code: int, down: bool) {
    let mut event: Vec<u8> = vec![0; 64]
    event.write_u32_le(0, if down { 0x300 } else { 0x301 })
    event.write_i32_le(16, code)
    check(SDL_PushEvent(&mut event) == 1, "push key")
    let _ = screen::present()
}
let g = engine::load(sys::arg(0).unwrap())
match screen::open("Elyra input commands test", g.playpal, 1) {
    Ok(_) => (),
    Err(e) => { println("FAIL {e}"); sys::exit(1) },
}
let _ = screen::present()
key(26, true)
check(screen::forward() == 25, "forward")
key(225, true)
check(screen::forward() == 50, "run")
key(22, true)
check(screen::forward() == 0, "opposite keys cancel")
key(22, false)
key(26, false)
key(225, false)
check(screen::forward() == 0, "release")
key(4, true)
check(screen::sideways() == -24, "strafe left")
key(4, false)
key(7, true)
check(screen::sideways() == 24, "strafe right")
key(7, false)
key(80, true)
check(screen::turn() == 640, "turn left")
key(80, false)
key(79, true)
check(screen::turn() == -640, "turn right")
key(79, false)
key(8, true)
check(screen::using(), "use E")
key(8, false)
key(44, true)
check(screen::using(), "use Space")
let mut event: Vec<u8> = vec![0; 64]
event.write_u32_le(0, 0x200)
event[12] = 13
check(SDL_PushEvent(&mut event) == 1, "push focus lost")
let _ = screen::present()
check(!screen::using() && screen::forward() == 0 && screen::turn() == 0 && screen::sideways() == 0, "focus lost clears keys")
event.write_u32_le(0, 0x400)
event.write_i32_le(28, 12)
check(SDL_PushEvent(&mut event) == 1, "push mouse motion")
let _ = screen::present()
check(screen::look_delta() == -12 * 2097152 && screen::look_delta() == 0, "relative mouse consumed once")
event.write_u32_le(0, 0x401)
event[16] = 1
check(SDL_PushEvent(&mut event) == 1, "push fire")
let _ = screen::present()
check(screen::firing(), "mouse fires")
event.write_u32_le(0, 0x402)
check(SDL_PushEvent(&mut event) == 1, "push fire release")
let _ = screen::present()
check(!screen::firing(), "mouse fire release")
event.write_u32_le(0, 0x100)
check(SDL_PushEvent(&mut event) == 1, "push quit")
check(!screen::present(), "quit event")
screen::close()
println("PASS: SDL down/up, run, opposing keys, strafing, turning, use, focus loss, quit")
