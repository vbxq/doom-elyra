use std::sys
use std::io::{println}
use screen
use engine
use play
use camera
use combat

fn keyboard_tic() {
    if combat::health() == 0 {
        if screen::restarting() {
            let g = engine::load(engine::flag_value("--wad", "freedoom1.wad"))
            camera::begin_tic()
        }
        return ()
    }
    play::tic(screen::forward(), screen::sideways(), screen::turn(), screen::using())
    combat::tick(screen::firing())
}

if !engine::has_flag("--demo") && !engine::has_flag("--timedemo") { engine::enable_gameplay() }

let wad_path = engine::flag_value("--wad", "freedoom1.wad")
let g = engine::load(wad_path)
let scale = match engine::flag_value("--scale", "3").to_int() {
    Some(n) => n,
    None => 3,
}
match screen::open("Elyra E1M1", g.playpal, scale) {
    Ok(_) => (),
    Err(e) => {
        println("sdl: {e}")
        sys::exit(1)
    },
}
if engine::has_flag("--timedemo") {
    engine::run_timedemo(screen::present)
} else if engine::has_flag("--demo") {
    engine::run_realtime(screen::present)
} else {
    let _ = screen::capture_mouse()
    engine::run_interactive(keyboard_tic, screen::look_delta, screen::present)
}
screen::close()
