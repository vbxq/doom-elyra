use render

extern "SDL2" {
    fn SDL_Init(flags: u32) -> i32
    fn SDL_GetError() -> cstr
    fn SDL_SetHint(name: cstr, value: cstr) -> bool
    fn SDL_CreateWindow(title: cstr, x: i32, y: i32, w: i32, h: i32, flags: u32) -> ptr
    fn SDL_CreateRenderer(window: ptr, index: i32, flags: u32) -> ptr
    fn SDL_CreateTexture(renderer: ptr, format: u32, access: i32, w: i32, h: i32) -> ptr
    fn SDL_CreateRGBSurfaceWithFormat(flags: u32, w: i32, h: i32, depth: i32, format: u32) -> ptr
    fn SDL_SetPaletteColors(palette: ptr, colors: &[u8], first: i32, count: i32) -> i32
    fn SDL_UpperBlit(src: ptr, src_rect: ptr, dst: ptr, dst_rect: ptr) -> i32
    fn SDL_UpdateTexture(texture: ptr, rect: ptr, pixels: ptr, pitch: i32) -> i32
    fn SDL_RenderClear(renderer: ptr) -> i32
    fn SDL_RenderCopy(renderer: ptr, texture: ptr, src: ptr, dst: ptr) -> i32
    fn SDL_RenderPresent(renderer: ptr)
    fn SDL_PollEvent(event: &mut [u8]) -> i32
    fn SDL_SetRelativeMouseMode(enabled: i32) -> i32
    fn SDL_FreeSurface(surface: ptr)
    fn SDL_DestroyTexture(texture: ptr)
    fn SDL_DestroyRenderer(renderer: ptr)
    fn SDL_DestroyWindow(window: ptr)
    fn SDL_Quit()
}

extern "c" {
    fn memcpy(dst: ptr, src: &[u8], n: u64) -> ptr
}

let W = 320
let H = 200
let SDL_INIT_VIDEO: u32 = 0x20
let SDL_WINDOWPOS_CENTERED = 0x2FFF0000
let SDL_PIXELFORMAT_INDEX8: u32 = 0x13000801
let SDL_PIXELFORMAT_ARGB8888: u32 = 0x16362004
let SDL_TEXTUREACCESS_STREAMING = 1
let SDL_RENDERER_SOFTWARE: u32 = 1
let SDL_QUIT: u32 = 0x100

let mut window = ptr::null()
let mut renderer = ptr::null()
let mut texture = ptr::null()
let mut indexed = ptr::null()
let mut argb = ptr::null()
let mut event: Vec<u8> = vec![0; 64]
let mut keys: Vec<bool> = vec![false; 512]
let mut mouse_x = 0
let mut mouse_fire = false

fn failed(what: string) -> Result<(), string> {
    Err("{what}: {SDL_GetError()}")
}

// the 8-bit surface is 320 bytes per row, so the framebuffer is copied in one piece
pub fn open(title: string, playpal: Vec<int>, scale: int) -> Result<(), string> {
    if SDL_Init(SDL_INIT_VIDEO) != 0 { return failed("SDL_Init") }
    SDL_SetHint("SDL_RENDER_SCALE_QUALITY", "0")
    SDL_SetHint("SDL_FRAMEBUFFER_ACCELERATION", "0")
    window = SDL_CreateWindow(title, SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED, W * scale, H * scale, 0)
    if window.is_null() { return failed("SDL_CreateWindow") }
    renderer = SDL_CreateRenderer(window, -1, SDL_RENDERER_SOFTWARE)
    if renderer.is_null() { return failed("SDL_CreateRenderer") }
    texture = SDL_CreateTexture(renderer, SDL_PIXELFORMAT_ARGB8888, SDL_TEXTUREACCESS_STREAMING, W, H)
    if texture.is_null() { return failed("SDL_CreateTexture") }
    indexed = SDL_CreateRGBSurfaceWithFormat(0, W, H, 8, SDL_PIXELFORMAT_INDEX8)
    argb = SDL_CreateRGBSurfaceWithFormat(0, W, H, 32, SDL_PIXELFORMAT_ARGB8888)
    if indexed.is_null() || argb.is_null() { return failed("SDL_CreateRGBSurfaceWithFormat") }
    if indexed.read_i32(24) as int != W { return Err("unexpected 8-bit surface pitch") }
    let mut colors: Vec<u8> = vec![255; 1024]
    for i in 0..256 {
        colors[i * 4] = playpal[i * 3] as u8
        colors[i * 4 + 1] = playpal[i * 3 + 1] as u8
        colors[i * 4 + 2] = playpal[i * 3 + 2] as u8
    }
    let palette = indexed.read_ptr(8).read_ptr(8)
    if SDL_SetPaletteColors(palette, &colors, 0, 256) != 0 { return failed("SDL_SetPaletteColors") }
    Ok(())
}

pub fn present() -> bool {
    let pixels = render::framebuffer()
    memcpy(indexed.read_ptr(32), &pixels, 64000)
    let blitted = SDL_UpperBlit(indexed, ptr::null(), argb, ptr::null()) == 0
    let uploaded = SDL_UpdateTexture(texture, ptr::null(), argb.read_ptr(32), argb.read_i32(24)) == 0
    let copied = SDL_RenderClear(renderer) == 0 && SDL_RenderCopy(renderer, texture, ptr::null(), ptr::null()) == 0
    let shown = blitted && uploaded && copied
    SDL_RenderPresent(renderer)
    let mut quit = false
    while SDL_PollEvent(&mut event) != 0 {
        let kind = event.read_u32_le(0)
        if kind == SDL_QUIT as int { quit = true }
        if kind == 0x300 || kind == 0x301 {
            let scancode = event.read_i32_le(16)
            if scancode >= 0 && scancode < keys.len() {
                keys[scancode] = kind == 0x300
            }
        }
        if kind == 0x400 { mouse_x += event.read_i32_le(28) }
        if (kind == 0x401 || kind == 0x402) && event[16] == 1 { mouse_fire = kind == 0x401 }
        if kind == 0x200 && event[12] == 13 {
            mouse_fire = false
            mouse_x = 0
            for i in 0..keys.len() { keys[i] = false }
        }
    }
    shown && !quit && !keys[41]
}

pub fn close() {
    SDL_FreeSurface(indexed)
    SDL_FreeSurface(argb)
    SDL_DestroyTexture(texture)
    SDL_DestroyRenderer(renderer)
    SDL_DestroyWindow(window)
    SDL_Quit()
}

pub fn forward() -> int {
    let speed = if keys[225] || keys[229] { 50 } else { 25 }
    (if keys[26] || keys[82] { speed } else { 0 }) - (if keys[22] || keys[81] { speed } else { 0 })
}

pub fn sideways() -> int {
    let speed = if keys[225] || keys[229] { 40 } else { 24 }
    (if keys[7] { speed } else { 0 }) - (if keys[4] { speed } else { 0 })
}

pub fn turn() -> int {
    (if keys[80] { 640 } else { 0 }) - (if keys[79] { 640 } else { 0 })
}

pub fn using() -> bool { keys[8] || keys[44] }

pub fn capture_mouse() -> bool { SDL_SetRelativeMouseMode(1) == 0 }
pub fn look_delta() -> int { let x = mouse_x; mouse_x = 0; -x * 2097152 }
pub fn firing() -> bool { mouse_fire || keys[224] || keys[228] }
pub fn restarting() -> bool { keys[21] }
